{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loancalc",
  "compatibility_date": "2026-05-02",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
